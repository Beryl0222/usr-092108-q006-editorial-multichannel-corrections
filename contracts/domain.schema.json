{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "评论稿多端更正链领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "TOPIC_CONFERENCE_RECORDED",
        "SOURCE_REGISTERED",
        "DRAFT_SUBMITTED",
        "DRAFT_REVIEWED",
        "FACT_CHECK_COMPLETED",
        "TITLE_SUMMARY_CANDIDATE_PROPOSED",
        "TITLE_SUMMARY_CONFIRMED",
        "VARIANT_PREPARED",
        "VARIANT_APPROVED",
        "PUBLICATION_CONFIRMED",
        "CHANNEL_RECEIPT_RECORDED",
        "CORRECTION_ORDERED",
        "CORRECTION_EXECUTED",
        "CHANNEL_RECONCILED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "editorial_item",
        "source_claim",
        "channel_variant",
        "correction_action"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
